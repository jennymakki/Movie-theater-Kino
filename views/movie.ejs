<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= movie.attributes.title %></title>
  </head>

  <body>
    <%- include('partials/header') %>
    <h1 class="movie-h1"><%= movie.attributes.title %></h1>
    <div class="movie-content">
      <img src="<%= movie.attributes.image.url %>" alt="<%= movie.attributes.title %>" class="movie-image">
      <p class="movie-intro"><%= movie.attributes.intro %></p>
    </div>
    <a href="/movies" class="back-link">Back to Movies</a>
    <%- include('partials/footer') %>
  </body>
</html>
