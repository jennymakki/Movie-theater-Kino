<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movies List</title>
</head>
<body>
    <%- include('partials/header'); %>
    <h1 class="movies-heading">Movies</h1>
    <ul class="movie-list">
        <% movies.forEach(function(movie) { %>
            <li class="movie-card">
                <a href="/movie/<%= movie.id %>" class="movie-link">
                    <section class="movie-card-inner">
                        <img src="<%= movie.attributes.image.url %>" alt="<%= movie.attributes.title %>" class="movie-image">
                        <div class="movie-info">
                            <h3 class="movie-title"><%= movie.attributes.title %></h3>
                            <p class="movie-intro"><%= movie.attributes.intro %></p>
                            <a href="https://www.imdb.com/title/<%= movie.attributes.imdbId %>/" target="_blank">
                                <img src="/kino-bio-projekt/assets/IMDb.png" alt="IMDb" class="imdb-logo">
                            </a>
                        </div>
                    </section>
                </a>
            </li> 
        <% }); %> 
    </ul>
    <%- include('partials/footer') %>
</body>
</html>